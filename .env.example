PORT=8787
API_TOKEN=change-this-token-before-deploy
DATA_FILE=./data/hindrax.json
JSON_BODY_LIMIT=10mb
# Comma-separated origins or *.
# Android native clients do not send Origin, but browser/WebView clients need this.
CORS_ORIGIN=*
DATABASE_URL=
PGSSLMODE=require

# Alternative production persistence for Firebase/Firestore.
# Put the full service account JSON in Vercel as one env var.
FIREBASE_PROJECT_ID=hindrax
FIREBASE_SERVICE_ACCOUNT_JSON=
